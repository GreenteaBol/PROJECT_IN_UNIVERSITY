library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity sseg_decoder_df is
    Port (
        bin      : in  STD_LOGIC_VECTOR(3 downto 0);
        sseg     : out STD_LOGIC_VECTOR(6 downto 0);
        an_ctrl  : in  STD_LOGIC_VECTOR(3 downto 0);
        sseg_en  : out STD_LOGIC
    );
end sseg_decoder_df;

architecture Dataflow of sseg_decoder_df is
begin
    sseg <= "1000000" when bin = "0000" else -- 0
            "1111001" when bin = "0001" else -- 1
            "0100100" when bin = "0010" else -- 2
            "0110000" when bin = "0011" else -- 3
            "0011001" when bin = "0100" else -- 4
            "0010010" when bin = "0101" else -- 5
            "0000010" when bin = "0110" else -- 6
            "1111000" when bin = "0111" else -- 7
            "0000000" when bin = "1000" else -- 8
            "0010000" when bin = "1001" else -- 9
            "1111111";

    sseg_en <= '1';
end Dataflow;
